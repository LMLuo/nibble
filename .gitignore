node_modules/
dist/

# wrangler 本地状态（账号/缓存），不得入库
.wrangler/

# 构建产物：由 tools/sync-lib.js 从 plugins/nibble/hooks/ 生成
vscode-extension/lib/

# 图标的 AI 源图（icon.png 已入库，需要改图标时再放回来跑 npm run icon）
vscode-extension/icon-src/

# 本地预览产物
vscode-extension/media/preview.html

# 官网构建产物：由 tools/build-site.js 从 site/ + plugins/nibble/hooks/ + vscode-extension/media/ 组装
_site/

# 像素字体的官方原始包（3.8MB/个，可再从 release 下载）；
# 子集化产物 site/fonts/*.woff2 与 LICENSE(OFL.txt) 要入库，官网直接引用
site/fonts/src/

# 武器/怪物素材：真源是 sheets/（AI 原图，不可再生），cells/ 由 tools/*-sprites.mjs 切出
legacy-mods/assets/weapons/cells/
legacy-mods/assets/monsters/cells/

# 像素校验用的放大预览图，由 png2grid.mjs / weapons-sprites.mjs 重新生成
legacy-mods/preview/
legacy-mods/tools/preview/

# Python 构建期工具（legacy-mods/tools/player-sprite.py）的字节码缓存
__pycache__/

*.log
.DS_Store
